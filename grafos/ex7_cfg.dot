digraph "ex7_cfg" {
  rankdir=TB;
  compound=true;
  node [fontname="Helvetica", fontsize=11, style=filled, fillcolor="white"];
  edge [fontname="Helvetica", fontsize=9];
  "S1" [label="ENTRY\nSTUDENT Marta LEVEL UNIVERSITY", shape="oval", fillcolor="white"];
  "S2" [label="S2  (l.3)\nUC \"Algebra\" { CREDITS 6 DIFFICULTY 5 }", shape="box", fillcolor="white"];
  "S3" [label="S3  (l.4)\nUC \"Historia\" { CREDITS 3 DIFFICULTY 1 }", shape="box", fillcolor="white"];
  "S4" [label="S4  (l.6)\nRESOURCE TIME 25 HOURS", shape="box", fillcolor="white"];
  "S5" [label="S5  (l.7)\nVAR base = 2", shape="box", fillcolor="#dbe9f7"];
  "S6" [label="S6  (l.8)\nVAR bonus = 10", shape="box", fillcolor="#dbe9f7"];
  "S7" [label="S7  (l.11)\nVAR total = 0", shape="box", fillcolor="#dbe9f7"];
  "S8" [label="S8  (l.12)\nbonus = 1", shape="box", fillcolor="#dbe9f7"];
  "S9" [label="S9  (l.13)\nFOR EACH u IN [\"Algebra\", \"Historia\"]", shape="hexagon", fillcolor="#e6dcf5"];
  "S10" [label="S10  (l.14)\nVAR h = base * u.DIFFICULTY", shape="box", fillcolor="#dbe9f7"];
  "S11" [label="S11  (l.15)\nIF ( base > 10 )", shape="diamond", fillcolor="#f9d9d9"];
  "S12" [label="S12  (l.16)\nSTUDY u FOR 50 HOURS\n[inalcançável]", shape="box", fillcolor="#eeeeee"];
  "S13" [label="S13  (l.18)\nSTUDY u FOR h + bonus HOURS", shape="box", fillcolor="#dbe9f7"];
  "S14" [label="S14  (l.20)\ntotal = total + h", shape="box", fillcolor="#dbe9f7"];
  "S15" [label="S15  (l.22)\nVAR resto = 25 - total", shape="box", fillcolor="#dbe9f7"];
  "S16" [label="EXIT", shape="oval", fillcolor="white"];
  "S1" -> "S2" [label=""];
  "S2" -> "S3" [label=""];
  "S3" -> "S4" [label=""];
  "S4" -> "S5" [label=""];
  "S5" -> "S6" [label=""];
  "S6" -> "S7" [label=""];
  "S7" -> "S8" [label=""];
  "S8" -> "S9" [label=""];
  "S9" -> "S10" [label="próximo"];
  "S9" -> "S15" [label="fim"];
  "S10" -> "S11" [label=""];
  "S11" -> "S12" [label="V [nunca]", style="dashed", color="#999999"];
  "S11" -> "S13" [label="F"];
  "S12" -> "S14" [label=""];
  "S13" -> "S14" [label=""];
  "S14" -> "S9" [label="(retorno)", color="#c0392b", fontcolor="#c0392b"];
  "S15" -> "S16" [label=""];
}