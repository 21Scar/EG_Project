digraph "ex1_cfg_blocos" {
  rankdir=TB;
  compound=true;
  node [fontname="Helvetica", fontsize=11, style=filled, fillcolor="white"];
  edge [fontname="Helvetica", fontsize=9];
  "ENTRY" [label="ENTRY", shape="oval"];
  "B1" [label="B1\nl.3: UC \"Sistemas Distribuidos\" { CREDITS 6 DIFFICULTY 4 }\nl.4: UC \"Engenharia Gramatical\" { CREDITS 6 DIFFICULTY 5 }\nl.5: UC \"Redes\" { CREDITS 3 DIFFICULTY 2 }\nl.7: RESOURCE TIME 30 HOURS\nl.8: VAR max_session = 4", shape="box", fillcolor="#dbe9f7"];
  "B2" [label="B2\nl.11: FOR EACH u IN [\"Sistemas Distribuidos\", \"Engenharia Gramatical\", \"Redes\"]", shape="hexagon", fillcolor="#e6dcf5"];
  "B3" [label="B3\nl.12: VAR h = u.CREDITS * 2", shape="box", fillcolor="#dbe9f7"];
  "B4" [label="B4\nl.13: IF ( u.DIFFICULTY > 3 AND h <= max_session * 3 )", shape="diamond", fillcolor="#f9d9d9"];
  "B5" [label="B5\nl.14: STUDY u FOR h HOURS", shape="box", fillcolor="#dbe9f7"];
  "B6" [label="B6\nl.15: IF ( u.CREDITS < 4 OR NOT u.DIFFICULTY > 2 )", shape="diamond", fillcolor="#f9d9d9"];
  "B7" [label="B7\nl.16: STUDY u FOR 2 HOURS", shape="box", fillcolor="#dbe9f7"];
  "B8" [label="B8\nl.18: STUDY u FOR max_session HOURS", shape="box", fillcolor="#dbe9f7"];
  "B9" [label="B9\nl.21: STUDY \"Redes\" FOR 3 HOURS", shape="box", fillcolor="#dbe9f7"];
  "EXIT" [label="EXIT", shape="oval"];
  "ENTRY" -> "B1" [label=""];
  "B1" -> "B2" [label=""];
  "B2" -> "B3" [label="próximo"];
  "B2" -> "B9" [label="fim"];
  "B3" -> "B4" [label=""];
  "B4" -> "B5" [label="V"];
  "B4" -> "B6" [label="F"];
  "B5" -> "B2" [label="", color="#c0392b", fontcolor="#c0392b"];
  "B6" -> "B7" [label="V"];
  "B6" -> "B8" [label="F"];
  "B7" -> "B2" [label="", color="#c0392b", fontcolor="#c0392b"];
  "B8" -> "B2" [label="", color="#c0392b", fontcolor="#c0392b"];
  "B9" -> "EXIT" [label=""];
}