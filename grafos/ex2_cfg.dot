digraph "ex2_cfg" {
  rankdir=TB;
  compound=true;
  node [fontname="Helvetica", fontsize=11, style=filled, fillcolor="white"];
  edge [fontname="Helvetica", fontsize=9];
  "S1" [label="ENTRY\nSTUDENT Joao LEVEL SECONDARY", shape="oval", fillcolor="white"];
  "S2" [label="S2  (l.3)\nUC \"Matematica A\" { DIFFICULTY 5 }", shape="box", fillcolor="white"];
  "S3" [label="S3  (l.4)\nUC \"Fisica\" { DIFFICULTY 4 }", shape="box", fillcolor="white"];
  "S4" [label="S4  (l.5)\nUC \"Portugues\" { DIFFICULTY 2 }", shape="box", fillcolor="white"];
  "S5" [label="S5  (l.7)\nRESOURCE TIME 20 HOURS", shape="box", fillcolor="white"];
  "S6" [label="S6  (l.8)\nVAR base = 2", shape="box", fillcolor="#dbe9f7"];
  "S7" [label="S7  (l.11)\nVAR extra = 1", shape="box", fillcolor="#dbe9f7"];
  "S8" [label="S8  (l.12)\nFOR EACH u IN [\"Matematica A\", \"Fisica\", \"Portugues\"]", shape="hexagon", fillcolor="#e6dcf5"];
  "S9" [label="S9  (l.13)\nVAR h = base + u.DIFFICULTY", shape="box", fillcolor="#dbe9f7"];
  "S10" [label="S10  (l.14)\nIF ( u.DIFFICULTY >= 4 )", shape="diamond", fillcolor="#f9d9d9"];
  "S11" [label="S11  (l.15)\nVAR extra = 2", shape="box", fillcolor="#dbe9f7"];
  "S12" [label="S12  (l.16)\nSTUDY u FOR h + extra HOURS", shape="box", fillcolor="#dbe9f7"];
  "S13" [label="S13  (l.18)\nSTUDY u FOR h HOURS", shape="box", fillcolor="#dbe9f7"];
  "S14" [label="S14  (l.21)\nextra = extra + 1", shape="box", fillcolor="#dbe9f7"];
  "S15" [label="EXIT", shape="oval", fillcolor="white"];
  "S1" -> "S2" [label=""];
  "S2" -> "S3" [label=""];
  "S3" -> "S4" [label=""];
  "S4" -> "S5" [label=""];
  "S5" -> "S6" [label=""];
  "S6" -> "S7" [label=""];
  "S7" -> "S8" [label=""];
  "S8" -> "S9" [label="próximo"];
  "S8" -> "S14" [label="fim"];
  "S9" -> "S10" [label=""];
  "S10" -> "S11" [label="V"];
  "S10" -> "S13" [label="F"];
  "S11" -> "S12" [label=""];
  "S12" -> "S8" [label="(retorno)", color="#c0392b", fontcolor="#c0392b"];
  "S13" -> "S8" [label="(retorno)", color="#c0392b", fontcolor="#c0392b"];
  "S14" -> "S15" [label=""];
}