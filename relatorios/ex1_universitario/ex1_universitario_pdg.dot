digraph "ex1_universitario_pdg" {
  rankdir=TB;
  compound=true;
  node [fontname="Helvetica", fontsize=11, style=filled, fillcolor="white"];
  edge [fontname="Helvetica", fontsize=9];
  "S1" [label="ENTRY", shape="oval"];
  "S6" [label="S6 (l.8)\nVAR max_session = 4", shape="box", fillcolor="#c8ecd0", peripheries="1"];
  "S7" [label="S7 (l.11)\nFOR EACH u IN [\"Sistemas Distribuidos\", \"Engenharia Gramatical\", \"Redes\"]", shape="hexagon", fillcolor="#c8ecd0", peripheries="1"];
  "S8" [label="S8 (l.12)\nVAR h = u.CREDITS * 2", shape="box", fillcolor="#c8ecd0", peripheries="1"];
  "S9" [label="S9 (l.13)\nIF ( u.DIFFICULTY > 3 AND h <= max_session * 3 )", shape="diamond", fillcolor="#c8ecd0", peripheries="1"];
  "S10" [label="S10 (l.14)\nSTUDY u FOR h HOURS", shape="box", fillcolor="#c8ecd0", peripheries="2"];
  "S11" [label="S11 (l.15)\nIF ( u.CREDITS < 4 OR NOT u.DIFFICULTY > 2 )", shape="diamond", fillcolor="#c8ecd0", peripheries="1"];
  "S12" [label="S12 (l.16)\nSTUDY u FOR 2 HOURS", shape="box", fillcolor="#c8ecd0", peripheries="2"];
  "S13" [label="S13 (l.18)\nSTUDY u FOR max_session HOURS", shape="box", fillcolor="#c8ecd0", peripheries="2"];
  "S14" [label="S14 (l.21)\nSTUDY \"Redes\" FOR 3 HOURS", shape="box", fillcolor="#c8ecd0", peripheries="2"];
  "S1" -> "S6" [style="dashed", color="#555555", label=""];
  "S1" -> "S7" [style="dashed", color="#555555", label=""];
  "S1" -> "S14" [style="dashed", color="#555555", label=""];
  "S6" -> "S9" [label="max_session", color="#1f5fa8", fontcolor="#1f5fa8"];
  "S6" -> "S13" [label="max_session", color="#1f5fa8", fontcolor="#1f5fa8"];
  "S7" -> "S8" [style="dashed", color="#555555", label="próximo + dados: u"];
  "S7" -> "S9" [style="dashed", color="#555555", label="próximo + dados: u"];
  "S7" -> "S11" [label="u", color="#1f5fa8", fontcolor="#1f5fa8"];
  "S7" -> "S13" [label="u", color="#1f5fa8", fontcolor="#1f5fa8"];
  "S7" -> "S10" [label="u", color="#1f5fa8", fontcolor="#1f5fa8"];
  "S7" -> "S12" [label="u", color="#1f5fa8", fontcolor="#1f5fa8"];
  "S8" -> "S9" [label="h", color="#1f5fa8", fontcolor="#1f5fa8"];
  "S8" -> "S10" [label="h", color="#1f5fa8", fontcolor="#1f5fa8"];
  "S9" -> "S10" [style="dashed", color="#555555", label="V"];
  "S9" -> "S11" [style="dashed", color="#555555", label="F"];
  "S11" -> "S12" [style="dashed", color="#555555", label="V"];
  "S11" -> "S13" [style="dashed", color="#555555", label="F"];
}