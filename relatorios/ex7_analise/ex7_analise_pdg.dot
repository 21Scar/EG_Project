digraph "ex7_analise_pdg" {
  rankdir=TB;
  compound=true;
  node [fontname="Helvetica", fontsize=11, style=filled, fillcolor="white"];
  edge [fontname="Helvetica", fontsize=9];
  "S1" [label="ENTRY", shape="oval"];
  "S5" [label="S5 (l.7)\nVAR base = 2", shape="box", fillcolor="#c8ecd0", peripheries="1"];
  "S6" [label="S6 (l.8)\nVAR bonus = 10", shape="box", fillcolor="#eeeeee", peripheries="1"];
  "S7" [label="S7 (l.11)\nVAR total = 0", shape="box", fillcolor="#eeeeee", peripheries="1"];
  "S8" [label="S8 (l.12)\nbonus = 1", shape="box", fillcolor="#c8ecd0", peripheries="1"];
  "S9" [label="S9 (l.13)\nFOR EACH u IN [\"Algebra\", \"Historia\"]", shape="hexagon", fillcolor="#c8ecd0", peripheries="1"];
  "S10" [label="S10 (l.14)\nVAR h = base * u.DIFFICULTY", shape="box", fillcolor="#c8ecd0", peripheries="1"];
  "S11" [label="S11 (l.15)\nIF ( base > 10 )", shape="diamond", fillcolor="#c8ecd0", peripheries="1"];
  "S12" [label="S12 (l.16)\nSTUDY u FOR 50 HOURS", shape="box", fillcolor="#c8ecd0", peripheries="2"];
  "S13" [label="S13 (l.18)\nSTUDY u FOR h + bonus HOURS", shape="box", fillcolor="#c8ecd0", peripheries="2"];
  "S14" [label="S14 (l.20)\ntotal = total + h", shape="box", fillcolor="#eeeeee", peripheries="1"];
  "S15" [label="S15 (l.22)\nVAR resto = 25 - total", shape="box", fillcolor="#eeeeee", peripheries="1"];
  "S1" -> "S5" [style="dashed", color="#555555", label=""];
  "S1" -> "S6" [style="dashed", color="#555555", label=""];
  "S1" -> "S7" [style="dashed", color="#555555", label=""];
