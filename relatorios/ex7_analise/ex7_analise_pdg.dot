  "S5" -> "S10" [label="base", color="#1f5fa8", fontcolor="#1f5fa8"];
  "S7" -> "S14" [label="total", color="#1f5fa8", fontcolor="#1f5fa8"];
  "S7" -> "S15" [label="total", color="#1f5fa8", fontcolor="#1f5fa8"];
  "S8" -> "S13" [label="bonus", color="#1f5fa8", fontcolor="#1f5fa8"];
  "S9" -> "S10" [style="dashed", color="#555555", label="próximo + dados: u"];
