  "or_cond" [label="or_cond", shape="box", style="filled", fillcolor="#d2f1f1"];
  "and_cond" [label="and_cond", shape="box", style="filled", fillcolor="#e8d9f7"];
  "not_cond" [label="not_cond", shape="box", style="filled", fillcolor="#f7e7c4"];
