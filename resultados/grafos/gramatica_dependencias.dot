  "cond" [label="cond", shape="box", style="filled", fillcolor="white"];
  "else_part" [label="else_part", shape="box", style="filled", fillcolor="#fbd5d5"];
  "string_list" [label="string_list", shape="box", style="filled", fillcolor="white"];
