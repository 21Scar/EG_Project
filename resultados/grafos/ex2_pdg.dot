  "S13" [label="S13 (l.18)\nSTUDY u FOR h HOURS", shape="box", fillcolor="#c8ecd0", peripheries="2"];
  "S14" [label="S14 (l.21)\nextra = extra + 1", shape="box", fillcolor="#eeeeee", peripheries="1"];
