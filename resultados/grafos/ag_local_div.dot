digraph "expr → expr / expr" {
  rankdir=TB;
  compound=true;
  node [fontname="Helvetica", fontsize=11, style=filled, fillcolor="white"];
  edge [fontname="Helvetica", fontsize=9];
  subgraph cluster_0 {
    label=""; style="rounded"; color="#999999";
    "o1#" [label="expr", shape="plaintext", style="", fontsize="12"];
    "o1.const" [label="const", shape="ellipse", fillcolor="#fde2c4", fontsize="10"];
    "o1.env" [label="env", shape="ellipse", fillcolor="#d8f0d2", fontsize="10"];
    "o1.errors" [label="errors", shape="ellipse", fillcolor="#fde2c4", fontsize="10"];
    "o1.type" [label="type", shape="ellipse", fillcolor="#fde2c4", fontsize="10"];
    "o1.val" [label="val", shape="ellipse", fillcolor="#fde2c4", fontsize="10"];
  }
  subgraph cluster_1 {
    label=""; style="rounded"; color="#999999";
    "o2#" [label="expr₁", shape="plaintext", style="", fontsize="12"];
    "o2.const" [label="const", shape="ellipse", fillcolor="#fde2c4", fontsize="10"];
    "o2.env" [label="env", shape="ellipse", fillcolor="#d8f0d2", fontsize="10"];
    "o2.errors" [label="errors", shape="ellipse", fillcolor="#fde2c4", fontsize="10"];
    "o2.type" [label="type", shape="ellipse", fillcolor="#fde2c4", fontsize="10"];
    "o2.val" [label="val", shape="ellipse", fillcolor="#fde2c4", fontsize="10"];
  }
  subgraph cluster_2 {
    label=""; style="rounded"; color="#999999";
    "o3#" [label="expr₂", shape="plaintext", style="", fontsize="12"];
    "o3.const" [label="const", shape="ellipse", fillcolor="#fde2c4", fontsize="10"];
    "o3.env" [label="env", shape="ellipse", fillcolor="#d8f0d2", fontsize="10"];
    "o3.errors" [label="errors", shape="ellipse", fillcolor="#fde2c4", fontsize="10"];
    "o3.type" [label="type", shape="ellipse", fillcolor="#fde2c4", fontsize="10"];
    "o3.val" [label="val", shape="ellipse", fillcolor="#fde2c4", fontsize="10"];
  }
  "o1#" -> "o2#" [style="invis", color="#aaaaaa", arrowhead="none", weight="5", ltail="cluster_0", lhead="cluster_1"];
  "o1#" -> "o3#" [style="invis", color="#aaaaaa", arrowhead="none", weight="5", ltail="cluster_0", lhead="cluster_2"];
  "o1.env" -> "o2.env" [constraint="false"];
  "o1.env" -> "o3.env" [constraint="false"];
  "o2.const" -> "o1.const" [constraint="false"];
  "o2.const" -> "o1.val" [constraint="false"];
  "o2.errors" -> "o1.errors" [constraint="false"];
  "o2.type" -> "o1.type" [constraint="false"];
  "o2.val" -> "o1.val" [constraint="false"];
  "o3.const" -> "o1.const" [constraint="false"];
  "o3.const" -> "o1.val" [constraint="false"];
  "o3.const" -> "o1.errors" [constraint="false"];
  "o3.errors" -> "o1.errors" [constraint="false"];
  "o3.type" -> "o1.type" [constraint="false"];
  "o3.val" -> "o1.val" [constraint="false"];
  "o3.val" -> "o1.errors" [constraint="false"];
  "o3.val" -> "o1.const" [constraint="false"];
}