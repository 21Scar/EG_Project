digraph "ex1_cfg" {
  rankdir=TB;
  compound=true;
  node [fontname="Helvetica", fontsize=11, style=filled, fillcolor="white"];
  edge [fontname="Helvetica", fontsize=9];
  "S1" [label="ENTRY\nSTUDENT Leonor LEVEL UNIVERSITY", shape="oval", fillcolor="white"];
  "S2" [label="S2  (l.3)\nUC \"Sistemas Distribuidos\" { CREDITS 6 DIFFICULTY 4 }", shape="box", fillcolor="white"];
  "S3" [label="S3  (l.4)\nUC \"Engenharia Gramatical\" { CREDITS 6 DIFFICULTY 5 }", shape="box", fillcolor="white"];
  "S4" [label="S4  (l.5)\nUC \"Redes\" { CREDITS 3 DIFFICULTY 2 }", shape="box", fillcolor="white"];
  "S5" [label="S5  (l.7)\nRESOURCE TIME 30 HOURS", shape="box", fillcolor="white"];
  "S6" [label="S6  (l.8)\nVAR max_session = 4", shape="box", fillcolor="#dbe9f7"];
  "S7" [label="S7  (l.11)\nFOR EACH u IN [\"Sistemas Distribuidos\", \"Engenharia Gramatical\", \"Redes\"]", shape="hexagon", fillcolor="#e6dcf5"];
  "S8" [label="S8  (l.12)\nVAR h = u.CREDITS * 2", shape="box", fillcolor="#dbe9f7"];
  "S9" [label="S9  (l.13)\nIF ( u.DIFFICULTY > 3 AND h <= max_session * 3 )", shape="diamond", fillcolor="#f9d9d9"];
  "S10" [label="S10  (l.14)\nSTUDY u FOR h HOURS", shape="box", fillcolor="#dbe9f7"];
  "S11" [label="S11  (l.15)\nIF ( u.CREDITS < 4 OR NOT u.DIFFICULTY > 2 )", shape="diamond", fillcolor="#f9d9d9"];
  "S12" [label="S12  (l.16)\nSTUDY u FOR 2 HOURS", shape="box", fillcolor="#dbe9f7"];
  "S13" [label="S13  (l.18)\nSTUDY u FOR max_session HOURS", shape="box", fillcolor="#dbe9f7"];
  "S14" [label="S14  (l.21)\nSTUDY \"Redes\" FOR 3 HOURS", shape="box", fillcolor="#dbe9f7"];
  "S15" [label="EXIT", shape="oval", fillcolor="white"];
  "S1" -> "S2" [label=""];
  "S2" -> "S3" [label=""];
  "S3" -> "S4" [label=""];
  "S4" -> "S5" [label=""];
  "S5" -> "S6" [label=""];
  "S6" -> "S7" [label=""];
  "S7" -> "S8" [label="próximo"];
  "S7" -> "S14" [label="fim"];
  "S8" -> "S9" [label=""];
  "S9" -> "S10" [label="V"];
  "S9" -> "S11" [label="F"];
  "S10" -> "S7" [label="(retorno)", color="#c0392b", fontcolor="#c0392b"];
  "S11" -> "S12" [label="V"];
  "S11" -> "S13" [label="F"];
  "S12" -> "S7" [label="(retorno)", color="#c0392b", fontcolor="#c0392b"];
  "S13" -> "S7" [label="(retorno)", color="#c0392b", fontcolor="#c0392b"];
  "S14" -> "S15" [label=""];
}