digraph "ex1_universitario_dfg" {
  rankdir=TB;
  compound=true;
  node [fontname="Helvetica", fontsize=11, style=filled, fillcolor="white"];
  edge [fontname="Helvetica", fontsize=9];
  "S6" [label="S6 (l.8)\nVAR max_session = 4", shape="box", fillcolor="#dbe9f7", style="filled"];
  "S7" [label="S7 (l.11)\nFOR EACH u IN [\"Sistemas Distribuidos\", \"Engenharia Gramatical\", \"Redes\"]", shape="box", fillcolor="#e6dcf5", style="filled"];
  "S8" [label="S8 (l.12)\nVAR h = u.CREDITS * 2", shape="box", fillcolor="#dbe9f7", style="filled"];
  "S9" [label="S9 (l.13)\nIF ( u.DIFFICULTY > 3 AND h <= max_session * 3 )", shape="box", fillcolor="#f9d9d9", style="filled"];
  "S10" [label="S10 (l.14)\nSTUDY u FOR h HOURS", shape="box", fillcolor="#dbe9f7", style="filled"];
  "S11" [label="S11 (l.15)\nIF ( u.CREDITS < 4 OR NOT u.DIFFICULTY > 2 )", shape="box", fillcolor="#f9d9d9", style="filled"];
  "S12" [label="S12 (l.16)\nSTUDY u FOR 2 HOURS", shape="box", fillcolor="#dbe9f7", style="filled"];
  "S13" [label="S13 (l.18)\nSTUDY u FOR max_session HOURS", shape="box", fillcolor="#dbe9f7", style="filled"];
  "S6" -> "S13" [label="max_session"];
  "S6" -> "S9" [label="max_session"];
  "S7" -> "S10" [label="u"];
  "S7" -> "S11" [label="u"];
  "S7" -> "S12" [label="u"];
  "S7" -> "S13" [label="u"];
  "S7" -> "S8" [label="u"];
  "S7" -> "S9" [label="u"];
  "S8" -> "S10" [label="h"];
  "S8" -> "S9" [label="h"];
}