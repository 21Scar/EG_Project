digraph "ex2_secundario_cfg_blocos" {
  rankdir=TB;
  compound=true;
  node [fontname="Helvetica", fontsize=11, style=filled, fillcolor="white"];
  edge [fontname="Helvetica", fontsize=9];
  "ENTRY" [label="ENTRY", shape="oval"];
  "B1" [label="B1\nl.3: UC \"Matematica A\" { DIFFICULTY 5 }\nl.4: UC \"Fisica\" { DIFFICULTY 4 }\nl.5: UC \"Portugues\" { DIFFICULTY 2 }\nl.7: RESOURCE TIME 20 HOURS\nl.8: VAR base = 2\nl.11: VAR extra = 1", shape="box", fillcolor="#dbe9f7"];
  "B2" [label="B2\nl.12: FOR EACH u IN [\"Matematica A\", \"Fisica\", \"Portugues\"]", shape="hexagon", fillcolor="#e6dcf5"];
  "B3" [label="B3\nl.13: VAR h = base + u.DIFFICULTY", shape="box", fillcolor="#dbe9f7"];
  "B4" [label="B4\nl.14: IF ( u.DIFFICULTY >= 4 )", shape="diamond", fillcolor="#f9d9d9"];
  "B5" [label="B5\nl.15: VAR extra = 2\nl.16: STUDY u FOR h + extra HOURS", shape="box", fillcolor="#dbe9f7"];
  "B6" [label="B6\nl.18: STUDY u FOR h HOURS", shape="box", fillcolor="#dbe9f7"];
  "B7" [label="B7\nl.21: extra = extra + 1", shape="box", fillcolor="#dbe9f7"];
  "EXIT" [label="EXIT", shape="oval"];
  "ENTRY" -> "B1" [label=""];
  "B1" -> "B2" [label=""];
  "B2" -> "B3" [label="próximo"];
  "B2" -> "B7" [label="fim"];
  "B3" -> "B4" [label=""];
  "B4" -> "B5" [label="V"];
  "B4" -> "B6" [label="F"];
  "B5" -> "B2" [label="", color="#c0392b", fontcolor="#c0392b"];
  "B6" -> "B2" [label="", color="#c0392b", fontcolor="#c0392b"];
  "B7" -> "EXIT" [label=""];
}